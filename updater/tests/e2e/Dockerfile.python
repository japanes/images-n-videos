# Fake app / stt image for the updater end-to-end test.
FROM python:3.12-slim
ARG FAKE_ROLE=app
ARG FAKE_VERSION=0.0.0
ARG FAKE_PORT=8787
ARG FAKE_BROKEN=0
ENV FAKE_ROLE=${FAKE_ROLE} FAKE_VERSION=${FAKE_VERSION} FAKE_PORT=${FAKE_PORT} \
    FAKE_BROKEN=${FAKE_BROKEN} PYTHONUNBUFFERED=1
COPY fake_service.py /fake_service.py
CMD ["python3", "/fake_service.py"]
